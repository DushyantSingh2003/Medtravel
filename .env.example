# Used by infra/docker-compose.yml. Every value is optional: the defaults below are what
# the compose file uses when nothing is set, and they match each app's .env.example.
# Copy to .env only if you need to change a port (for example when 5432 is already taken).

POSTGRES_USER=medtravel
POSTGRES_PASSWORD=medtravel
POSTGRES_DB=medtravel
POSTGRES_PORT=5432

REDIS_PORT=6379

S3_ACCESS_KEY=medtravel
S3_SECRET_KEY=medtravel-secret
S3_PRIVATE_BUCKET=medtravel-private
S3_PUBLIC_BUCKET=medtravel-public
S3_PORT=9000
S3_CONSOLE_PORT=9001

SMTP_PORT=1025
MAILPIT_UI_PORT=8025

CLAMAV_PORT=3310
