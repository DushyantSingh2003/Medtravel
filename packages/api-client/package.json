{
  "name": "@medtravel/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "orval --config orval.config.ts",
    "build": "orval --config orval.config.ts && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@medtravel/contracts": "workspace:*",
    "@tanstack/react-query": "^5.104.1"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@medtravel/config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "orval": "^8.41.0",
    "react": "^19.3.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.11"
  }
}
