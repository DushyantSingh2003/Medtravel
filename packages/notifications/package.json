    "test": "vitest run"
  },
  "dependencies": {
    "@medtravel/contracts": "workspace:*",
    "@medtravel/db": "workspace:*",
    "@medtravel/emails": "workspace:*",
    "@medtravel/i18n": "workspace:*",
    "@medtravel/realtime": "workspace:*",
    "nodemailer": "^10.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@medtravel/config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^9.39.5",
    "typescript": "^6.0.2",
    "vitest": "^4.1.11"
  },
  "bin": {
    "fake-smtp": "./dist/testing/fake-smtp-cli.js"
