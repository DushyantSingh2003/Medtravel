{
  "name": "@medtravel/storage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "fake-s3": "./dist/testing/fake-s3-cli.js",
    "fake-clamd": "./dist/testing/fake-clamd-cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/s3-request-presigner": "^3.1159.0",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@medtravel/config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "typescript": "^6.0.2",
    "vitest": "^4.1.11"
  }
}
