# Connection string used by the Prisma CLI (migrate, studio, seed) and by the API/worker
# at runtime through the pg driver adapter.
DATABASE_URL="postgresql://medtravel:medtravel@localhost:5432/medtravel?schema=public"

# Create one development user per role (docs/dev-users.md, password Dev@12345) when seeding. Local development and CI
# only: the seed refuses to run with this when NODE_ENV=production.
SEED_DEV_USERS=true
