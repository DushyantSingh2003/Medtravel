{
  "extends": "@medtravel/config/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noUncheckedIndexedAccess": false
  },
  "include": ["src/**/*.ts", "generated/**/*.ts", "prisma/seed-data/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/**/*.spec.ts", "prisma/seed.ts", "prisma7.config.ts"]
}
