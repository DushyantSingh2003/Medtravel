{
  "name": "@medtravel/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./testing": {
      "types": "./dist/src/testing/index.d.ts",
      "default": "./dist/src/testing/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "docs:model": "tsx scripts/generate-data-model-doc.ts",
    "db:reset": "tsx scripts/db-reset.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0"
  },
  "devDependencies": {
    "@medtravel/config": "workspace:*",
    "@medtravel/contracts": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "dotenv": "^18.0.6",
    "eslint": "^9.39.5",
    "libphonenumber-js": "^1.13.15",
    "prisma": "^7.10.0",
    "tsx": "^4.21.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.11"
  }
}
