// MedTravel database schema (PRD section 11).
//
// Conventions
//   - Primary keys are UUIDs generated by the database (gen_random_uuid()). The small reference tables
//     Country, Language and Currency use their ISO / BCP 47 code as the key.
//   - Business records have createdAt, updatedAt and deletedAt (soft delete). Append-only tables
//     (AuditEvent, OutboxEvent, CaseStageHistory, FxRate, Session, MedicalSummary) have no updatedAt.
//   - Times are timestamptz (UTC). Dates without a time (birthday, passport expiry) are `date`.
//   - Money is an Int in minor units next to an ISO currency code: never a float.
//   - Rates are basis points (1250 = 12.5%), so there are no floats there either. FX rates are
//     Decimal(18,8) because they are rates, not amounts.
//   - Every foreign key has an index (the Currency codes on money columns are the one exception: a handful
//     of distinct values is never a useful index). Columns the screens filter or sort by have indexes too.
//   - Enums mirror packages/contracts (the test in packages/db fails when they differ).
//   - Full-text search: `searchVector` columns on Hospital, Doctor, Treatment and Patient are generated
//     columns added in the migration SQL (Prisma cannot express them), with GIN indexes declared here.
//
// Prisma 7 note: the connection URL lives in prisma7.config.ts (for the CLI) and is passed
// to the driver adapter at runtime — it is no longer part of this file.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// The eleven roles of PRD section 2.
enum Role {
  patient
  attendant
  agent
  case_manager
  ground_coordinator
  interpreter
  medical_reviewer
  hospital_desk
  doctor
  finance
  super_admin
}

/// The twelve stages of a case, then the three that sit outside them.
enum CaseStage {
  enquiry
  qualification
  medical_review
  hospital_opinions
  quote_decision
  booking_deposit
  visa
  travel_planning
  arrival
  treatment
  discharge_return
  follow_up
  lost
  on_hold
  cancelled
}

/// Status values for filters and reports (PRD section 3).
enum CaseStatus {
  new
  qualifying
  in_medical_review
  awaiting_opinions
  quote_sent
  won
  visa_in_process
  travel_booked
  arrived
  in_treatment
  discharged
  returned_home
  follow_up
  closed
  lost
  on_hold
  cancelled
}

/// A normal sign-in, or a magic link limited to one case.
enum SessionKind {
  user
  magic_link
}

/// What a one-time secret in `AuthChallenge` is for.
enum AuthChallengeKind {
  email_verification
  password_reset
  login_code
  invitation
  magic_link
}

/// Login state of a user.
enum UserStatus {
  invited
  active
  suspended
  deactivated
}

/// Patient gender.
enum Gender {
  female
  male
  other
  undisclosed
}

/// How quickly a case needs treatment.
enum Urgency {
  routine
  soon
  urgent
  emergency
}

/// Where a lead came from (PRD 6, lead inbox).
enum CaseSource {
  website
  whatsapp
  phone
  email
  agent
  referral
  walk_in
  other
}

/// Broad category of a stored file (PRD 11).
enum DocumentKind {
  report
  scan
  prescription
  passport
  visa
  invoice
  bill
  discharge
  invitation_letter
  photo
  pickup_photo
  kyc
  agreement
  other
}

/// private: the patient and our staff, and any hospital with a live DocumentShare; internal: our staff only. Hospital access is never a flag: it is a DocumentShare row.
enum DocumentVisibility {
  private
  internal
}

/// Where a browser upload stands: the API tracks each one so it only signs requests for uploads it started.
enum FileUploadStatus {
  open
  completed
  aborted
  expired
}

/// Result of the virus scan on an uploaded file.
enum ScanStatus {
  pending
  clean
  infected
  failed
}

/// What a patient agreed to.
enum ConsentType {
  data_processing
  share_medical_with_hospital
  share_stage_with_agent
  marketing
  public_review
  whatsapp_contact
}

/// Onboarding and publishing state of a hospital profile.
enum HospitalStatus {
  draft
  pending_review
  approved
  published
  unpublished
  suspended
}

/// Who issued an accreditation.
enum AccreditationBody {
  nabh
  jci
  nabl
  iso
  other
}

/// Where a request to a hospital stands.
enum OpinionRequestStatus {
  draft
  sent
  viewed
  accepted
  declined
  answered
  expired
  cancelled
}

/// Quote lifecycle.
enum QuoteStatus {
  draft
  sent
  viewed
  accepted
  rejected
  expired
  superseded
}

/// What a quote line is for.
enum QuoteLineKind {
  hospital
  stay
  transfer
  interpreter
  service_fee
  add_on
  discount
  other
}

/// Deposit, our service fee, a hospital pass-through (not revenue), an add-on, or a hospital paying its referral fee.
enum PaymentType {
  deposit
  service
  pass_through
  add_on
  referral_fee
}

/// How a payment was made.
enum PaymentMethod {
  card
  bank_wire
  upi
  payment_link
  cash
  other
}

/// Payment lifecycle.
enum PaymentStatus {
  pending
  authorized
  succeeded
  failed
  cancelled
  partially_refunded
  refunded
  chargeback
}

/// Invoice to a patient for our fees, or to a hospital for the referral fee.
enum InvoiceKind {
  service_fee
  referral_fee
}

/// Invoice lifecycle.
enum InvoiceStatus {
  draft
  issued
  partially_paid
  paid
  overdue
  void
}

/// Credit note lifecycle.
enum CreditNoteStatus {
  draft
  issued
  void
}

/// Refund lifecycle.
enum RefundStatus {
  requested
  approved
  rejected
  processed
  failed
}

/// Visa category.
enum VisaType {
  medical
  medical_attendant
  other
}

/// Visa tracker status (PRD 6).
enum VisaStatus {
  not_started
  documents_pending
  invitation_requested
  invitation_issued
  applied
  approved
  rejected
  expired
}

/// Kind of booking (PRD 11).
enum BookingType {
  flight
  stay
  transfer
  interpreter
  sim
  other
}

/// Booking lifecycle (en_route and picked_up are for transfers).
enum BookingStatus {
  requested
  confirmed
  en_route
  picked_up
  in_progress
  completed
  cancelled
}

/// What a vendor supplies.
enum VendorKind {
  stay
  transport
  interpreter
  sim
  travel
  other
}

/// Kind of partner accommodation.
enum StayType {
  guest_house
  hotel
  service_apartment
}

/// Kind of vehicle.
enum VehicleType {
  sedan
  suv
  van
  wheelchair
  ambulance
}

/// Agent onboarding state.
enum AgentStatus {
  applied
  kyc_review
  approved
  suspended
  rejected
}

/// Agent tier (PRD 8, phase 3).
enum AgentTier {
  silver
  gold
  platinum
}

/// Commission lifecycle.
enum CommissionStatus {
  earned
  approved
  paid
  cancelled
}

/// Agent payout lifecycle.
enum PayoutStatus {
  requested
  approved
  processing
  paid
  failed
  cancelled
}

/// How an agent is paid.
enum PayoutMethod {
  international_wire
  local_transfer
}

/// Task lifecycle.
enum TaskStatus {
  open
  in_progress
  done
  cancelled
}

/// Task priority.
enum TaskPriority {
  low
  normal
  high
  urgent
}

/// Channel a message travelled on.
enum MessageChannel {
  in_app
  whatsapp
  email
  sms
}

/// inbound from the other party, outbound to them. Staff-only notes are CaseNote, not messages.
enum MessageDirection {
  inbound
  outbound
}

/// Who the conversation is with.
enum ConversationKind {
  patient
  hospital
  agent
  internal
}

/// Channel a notification is sent on.
enum NotificationChannel {
  in_app
  email
  whatsapp
  sms
  push
}

/// Delivery state.
enum NotificationStatus {
  queued
  sent
  delivered
  read
  failed
}

/// Kind of incident (PRD 6).
enum IncidentType {
  complaint
  medical_complication
  lost_documents
  delay
  other
}

/// How serious an incident is.
enum IncidentSeverity {
  low
  medium
  high
  critical
}

/// Incident lifecycle.
enum IncidentStatus {
  open
  escalated
  resolved
  closed
}

/// Where a hospital stay stands.
enum AdmissionStatus {
  planned
  admitted
  discharged
  cancelled
}

/// Outbox event state; the worker moves events along.
enum OutboxStatus {
  pending
  processing
  processed
  failed
}

/// How an interpreter works with us.
enum InterpreterEmployment {
  in_house
  freelance
}

/// ISO 3166 country (patients, agents, cities).
model Country {
  code             String               @id @db.Char(2)
  name             String
  dialCode         String?              @db.VarChar(8)
  region           String?
  active           Boolean              @default(true)
  cities           City[]
  translations     CountryTranslation[]
  patients         Patient[]
  patientsResident Patient[]            @relation("PatientResidence")
  attendants       Attendant[]
  cases            Case[]
  agents           Agent[]
  createdAt        DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @db.Timestamptz(3)
}

/// Interface and content language, by BCP 47 code (en, ar, ru, fr, ...).
model Language {
  code   String  @id @db.VarChar(8)
  name   String
  rtl    Boolean @default(false)
  active Boolean @default(true)
}

/// ISO 4217 currency and how many minor-unit digits it has (2 for USD, 0 for JPY, 3 for KWD).
model Currency {
  code                             String           @id @db.Char(3)
  name                             String
  minorUnits                       Int              @default(2)
  symbol                           String?          @db.VarChar(8)
  active                           Boolean          @default(true)
  fxRatesAsBase                    FxRate[]         @relation("FxBase")
  fxRatesAsQuote                   FxRate[]         @relation("FxQuote")
  casesByBudgetCurrency            Case[]           @relation("CaseBudgetCurrency")
  admissionsByCurrency             Admission[]      @relation("AdmissionCurrency")
  doctorsByConsultFeeCurrency      Doctor[]         @relation("DoctorConsultFeeCurrency")
  packagesByCurrency               Package[]        @relation("PackageCurrency")
  opinionsByCurrency               Opinion[]        @relation("OpinionCurrency")
  quotesByCurrency                 Quote[]          @relation("QuoteCurrency")
  quotesPricedFrom                 Quote[]          @relation("QuoteFxBaseCurrency")
  quoteLinesByCurrency             QuoteLine[]      @relation("QuoteLineCurrency")
  invoicesByCurrency               Invoice[]        @relation("InvoiceCurrency")
  creditNotesByCurrency            CreditNote[]     @relation("CreditNoteCurrency")
  paymentsByCurrency               Payment[]        @relation("PaymentCurrency")
  refundsByCurrency                Refund[]         @relation("RefundCurrency")
  stayRoomsByCurrency              StayRoom[]       @relation("StayRoomCurrency")
  interpretersByHourlyRateCurrency Interpreter[]    @relation("InterpreterHourlyRateCurrency")
  bookingsByCurrency               Booking[]        @relation("BookingCurrency")
  commissionsByCurrency            Commission[]     @relation("CommissionCurrency")
  payoutsByCurrency                Payout[]         @relation("PayoutCurrency")
  priceItemPrices                  PriceItemPrice[] @relation("PriceItemPriceCurrency")
  fxOverridesAsBase                FxOverride[]     @relation("FxOverrideBase")
  fxOverridesAsQuote               FxOverride[]     @relation("FxOverrideQuote")
}

/// Exchange rate: 1 base = rate quote, as of a moment. Quotes and payments copy the rate they used.
model FxRate {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rate              Decimal  @db.Decimal(18, 8)
  source            String
  asOf              DateTime @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  baseCurrency      String   @db.Char(3)
  baseCurrencyInfo  Currency @relation("FxBase", fields: [baseCurrency], references: [code], onDelete: Restrict)
  quoteCurrency     String   @db.Char(3)
  quoteCurrencyInfo Currency @relation("FxQuote", fields: [quoteCurrency], references: [code], onDelete: Restrict)

  @@unique([baseCurrency, quoteCurrency, asOf])
}

/// Medical speciality (cardiology, orthopaedics).
model Speciality {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug             String                  @unique
  name             String
  active           Boolean                 @default(true)
  treatments       Treatment[]
  translations     SpecialityTranslation[]
  medicalSummaries MedicalSummary[]
  departments      Department[]
  doctors          Doctor[]
  createdAt        DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?               @db.Timestamptz(3)
}

/// Procedure or treatment a patient can ask about (PRD 5.1).
model Treatment {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String                   @unique
  name            String
  summary         String?                  @db.Text
  typicalStayDays Int?
  active          Boolean                  @default(true)
  searchVector    Unsupported("tsvector")?
  specialityId    String                   @db.Uuid
  speciality      Speciality               @relation(fields: [specialityId], references: [id], onDelete: Restrict)
  translations    TreatmentTranslation[]
  cases           Case[]
  packages        Package[]
  commissionRules CommissionRule[]
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?                @db.Timestamptz(3)

  @@index([searchVector], type: Gin)
  @@index([specialityId])
}

/// City where treatment or logistics happen.
model City {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                String            @unique
  name                String
  active              Boolean           @default(true)
  countryCode         String            @db.Char(2)
  country             Country           @relation(fields: [countryCode], references: [code], onDelete: Restrict)
  translations        CityTranslation[]
  staffProfiles       StaffProfile[]
  casesPreferringCity Case[]            @relation("CasePreferredCity")
  hospitals           Hospital[]
  hospitalBranches    HospitalBranch[]
  vendors             Vendor[]
  stays               Stay[]
  drivers             Driver[]
  vehicles            Vehicle[]
  interpreters        Interpreter[]
  bookings            Booking[]
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt           DateTime?         @db.Timestamptz(3)

  @@index([countryCode])
}

/// Finer type of a stored file (MRI report, discharge summary); `kind` is its broad category.
model DocumentType {
  id           String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String                    @unique
  name         String
  kind         DocumentKind
  active       Boolean                   @default(true)
  translations DocumentTypeTranslation[]
  documents    Document[]
  createdAt    DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime                  @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime?                 @db.Timestamptz(3)
}

/// Mandatory reason when a case is marked lost (PRD 6).
model LostReason {
  id           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String                  @unique
  name         String
  active       Boolean                 @default(true)
  translations LostReasonTranslation[]
  cases        Case[]
  createdAt    DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime                @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime?               @db.Timestamptz(3)
}

/// Country text in one language. The canonical (English) text lives on Country itself.
model CountryTranslation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locale      String   @db.VarChar(8)
  name        String
  countryCode String   @db.Char(2)
  country     Country  @relation(fields: [countryCode], references: [code], onDelete: Cascade)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([countryCode, locale])
  @@index([locale])
}

/// Speciality text in one language. The canonical (English) text lives on Speciality itself.
model SpecialityTranslation {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locale       String     @db.VarChar(8)
  name         String
  specialityId String     @db.Uuid
  speciality   Speciality @relation(fields: [specialityId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  @@unique([specialityId, locale])
  @@index([locale])
}

/// Treatment text in one language. The canonical (English) text lives on Treatment itself.
model TreatmentTranslation {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locale      String    @db.VarChar(8)
  name        String
  summary     String?   @db.Text
  treatmentId String    @db.Uuid
  treatment   Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([treatmentId, locale])
  @@index([locale])
}

/// City text in one language. The canonical (English) text lives on City itself.
model CityTranslation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locale    String   @db.VarChar(8)
  name      String
  cityId    String   @db.Uuid
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([cityId, locale])
  @@index([locale])
}

/// DocumentType text in one language. The canonical (English) text lives on DocumentType itself.
model DocumentTypeTranslation {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locale         String       @db.VarChar(8)
  name           String
  documentTypeId String       @db.Uuid
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  @@unique([documentTypeId, locale])
  @@index([locale])
}

/// LostReason text in one language. The canonical (English) text lives on LostReason itself.
model LostReasonTranslation {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locale       String     @db.VarChar(8)
  name         String
  lostReasonId String     @db.Uuid
  lostReason   LostReason @relation(fields: [lostReasonId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  @@unique([lostReasonId, locale])
  @@index([locale])
}

/// One row per login. Linked to a Patient, Agent (AgentUser), HospitalStaff or StaffProfile by role.
model User {
  id                        String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                     String?                  @unique
  phone                     String?                  @unique @db.VarChar(20)
  name                      String
  role                      Role
  language                  String                   @default("en") @db.VarChar(8)
  timezone                  String?                  @db.VarChar(64)
  status                    UserStatus               @default(invited)
  passwordHash              String?
  twoFactorEnabled          Boolean                  @default(false)
  /// TOTP secret, encrypted by the application (AES-256-GCM); never readable from the database alone.
  twoFactorSecret           String?
  emailVerifiedAt           DateTime?                @db.Timestamptz(3)
  phoneVerifiedAt           DateTime?                @db.Timestamptz(3)
  passwordChangedAt         DateTime?                @db.Timestamptz(3)
  /// Consecutive failed password or code attempts; five lock the account for a while.
  failedLoginCount          Int                      @default(0)
  lockedUntil               DateTime?                @db.Timestamptz(3)
  lastLoginAt               DateTime?                @db.Timestamptz(3)
  sessions                  Session[]
  authChallenges            AuthChallenge[]          @relation("ChallengeUser")
  createdChallenges         AuthChallenge[]          @relation("ChallengeCreator")
  backupCodes               BackupCode[]
  staffProfile              StaffProfile?
  managedStaff              StaffProfile[]           @relation("StaffManager")
  managedTeams              Team[]                   @relation("TeamManager")
  priceVersionsCreated      PriceItemVersion[]       @relation("PriceItemVersionCreatedBy")
  changeRequestsSubmitted   PartnerChangeRequest[]   @relation("ChangeRequestSubmittedBy")
  changeRequestsDecided     PartnerChangeRequest[]   @relation("ChangeRequestDecidedBy")
  leadsCreated              Lead[]                   @relation("LeadCreatedBy")
  accreditationsVerified    Accreditation[]          @relation("AccreditationVerifiedBy")
  marginRulesUpdated        MarginRule[]             @relation("MarginRuleUpdatedBy")
  discountThresholdsUpdated DiscountThreshold[]      @relation("DiscountThresholdUpdatedBy")
  fxSettingsUpdated         FxSetting[]              @relation("FxSettingUpdatedBy")
  fxOverridesCreated        FxOverride[]             @relation("FxOverrideCreatedBy")
  leaves                    StaffLeave[]             @relation("StaffLeaveUser")
  agentUser                 AgentUser?
  patient                   Patient?
  attendant                 Attendant?
  ownedCases                Case[]                   @relation("CaseOwner")
  reviewedCases             Case[]                   @relation("CaseReviewer")
  stageChanges              CaseStageHistory[]
  medicalSummaries          MedicalSummary[]
  uploadedDocuments         Document[]               @relation("DocumentUploader")
  fileUploads               FileUpload[]
  notificationPreferences   NotificationPreference[]
  documentShares            DocumentShare[]
  caseNotes                 CaseNote[]
  hospitalStaffs            HospitalStaff[]
  sentOpinionRequests       OpinionRequest[]
  submittedOpinions         Opinion[]
  acceptedQuotes            Quote[]                  @relation("QuoteAcceptedBy")
  createdQuotes             Quote[]                  @relation("QuoteCreatedBy")
  requestedRefunds          Refund[]                 @relation("RefundRequestedBy")
  approvedRefunds           Refund[]                 @relation("RefundApprovedBy")
  interpreter               Interpreter?
  assignedTasks             Task[]                   @relation("TaskAssignee")
  createdTasks              Task[]                   @relation("TaskCreator")
  sentMessages              Message[]
  notifications             Notification[]
  reportedIncidents         Incident[]               @relation("IncidentReporter")
  assignedIncidents         Incident[]               @relation("IncidentAssignee")
  escalatedIncidents        Incident[]               @relation("IncidentEscalatedTo")
  createdAt                 DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                 @updatedAt @db.Timestamptz(3)
  deletedAt                 DateTime?                @db.Timestamptz(3)

  @@index([role, status])
}

/// A signed-in browser or device. Only a hash of the token is stored.
/// One sign-in on one device. `tokenHash` is the hash of the current refresh token; it rotates on every refresh and the
/// previous hash is kept so that a replayed (stolen) refresh token revokes the whole session.
model Session {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind                SessionKind @default(user)
  tokenHash           String      @unique
  previousTokenHash   String?     @unique
  rotatedAt           DateTime?   @db.Timestamptz(3)
  userAgent           String?
  deviceLabel         String?     @db.VarChar(120)
  ip                  String?     @db.VarChar(45)
  /// Set once the second factor was proven in this session; staff, hospital and admin sessions are limited until then.
  twoFactorVerifiedAt DateTime?   @db.Timestamptz(3)
  expiresAt           DateTime    @db.Timestamptz(3)
  revokedAt           DateTime?   @db.Timestamptz(3)
  lastUsedAt          DateTime?   @db.Timestamptz(3)
  createdAt           DateTime    @default(now()) @db.Timestamptz(3)
  userId              String      @db.Uuid
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// A magic-link session sees this one case and nothing else.
  scopeCaseId         String?     @db.Uuid
  scopeCase           Case?       @relation(fields: [scopeCaseId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@index([scopeCaseId])
}

/// A one-time secret sent to a person: email verification, password reset, a sign-in code, an invitation or a magic link.
/// Only hashes are stored; the token or code itself exists in the email and nowhere else.
model AuthChallenge {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind        AuthChallengeKind
  /// Lower-cased email address or phone number the secret was sent to.
  target      String?
  tokenHash   String?           @unique
  codeHash    String?
  attempts    Int               @default(0)
  /// What the secret allows: for an invitation the role, name and who it belongs to; for a magic link the case.
  meta        Json?
  expiresAt   DateTime          @db.Timestamptz(3)
  consumedAt  DateTime?         @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  userId      String?           @db.Uuid
  user        User?             @relation("ChallengeUser", fields: [userId], references: [id], onDelete: Cascade)
  createdById String?           @db.Uuid
  createdBy   User?             @relation("ChallengeCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([kind, target])
  @@index([userId, kind])
  @@index([createdById])
  @@index([expiresAt])
}

/// A single-use recovery code for a user who lost their authenticator app. Stored hashed.
model BackupCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codeHash  String
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Our own staff (case managers, reviewers, ground coordinators, interpreters, finance): city, languages and round-robin state.
model StaffProfile {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  isManager      Boolean   @default(false)
  title          String?
  languages      String[]
  assignable     Boolean   @default(true)
  maxOpenCases   Int?
  lastAssignedAt DateTime? @db.Timestamptz(3)
  userId         String    @unique @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cityId         String?   @db.Uuid
  city           City?     @relation(fields: [cityId], references: [id], onDelete: Restrict)
  managerId      String?   @db.Uuid
  manager        User?     @relation("StaffManager", fields: [managerId], references: [id], onDelete: SetNull)
  teamId         String?   @db.Uuid
  team           Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  /// Time zone and per-weekday intervals, e.g. { timezone: 'Asia/Kolkata', days: { mon: [{ from: '09:00', to: '18:00' }] } }.
  workingHours   Json?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime? @db.Timestamptz(3)

  @@index([cityId])
  @@index([managerId])
  @@index([teamId])
}

/// A group of staff under one manager. Joining a team sets the member's manager to the team's.
model Team {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String         @unique
  managerId String?        @db.Uuid
  manager   User?          @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  members   StaffProfile[]
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)
  deletedAt DateTime?      @db.Timestamptz(3)

  @@index([managerId])
}

/// Days a staff member is away; the assignment engine (C-02) skips them.
model StaffLeave {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  startsOn  DateTime  @db.Date
  endsOn    DateTime  @db.Date
  note      String?
  userId    String    @db.Uuid
  user      User      @relation("StaffLeaveUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([userId, startsOn])
}

/// A login belonging to an agent organisation (sub-users).
model AgentUser {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner     Boolean   @default(false)
  userId    String    @unique @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId   String    @db.Uuid
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Restrict)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([agentId])
}

/// A person seeking treatment. Has many Cases, Attendants and Documents. Personal data: never logged.
model Patient {
  id                       String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName                 String
  dateOfBirth              DateTime?                @db.Date
  gender                   Gender?
  passportNumber           String?                  @db.VarChar(32)
  passportExpiry           DateTime?                @db.Date
  phone                    String?                  @db.VarChar(20)
  email                    String?
  address                  String?                  @db.Text
  preferredLanguage        String                   @default("en") @db.VarChar(8)
  anonymizedAt             DateTime?                @db.Timestamptz(3)
  mergedIntoId             String?                  @db.Uuid
  mergedInto               Patient?                 @relation("PatientMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom               Patient[]                @relation("PatientMerge")
  mergedAt                 DateTime?                @db.Timestamptz(3)
  leads                    Lead[]                   @relation("LeadPatient")
  leadDuplicates           Lead[]                   @relation("LeadDuplicateOf")
  emergencyContactName     String?
  emergencyContactPhone    String?                  @db.VarChar(20)
  emergencyContactRelation String?
  searchVector             Unsupported("tsvector")?
  userId                   String?                  @unique @db.Uuid
  user                     User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  nationalityCode          String?                  @db.Char(2)
  nationality              Country?                 @relation(fields: [nationalityCode], references: [code], onDelete: Restrict)
  countryOfResidenceCode   String?                  @db.Char(2)
  countryOfResidence       Country?                 @relation("PatientResidence", fields: [countryOfResidenceCode], references: [code], onDelete: Restrict)
  attendants               Attendant[]
  consents                 Consent[]
  cases                    Case[]
  documents                Document[]
  visaApplications         VisaApplication[]
  feedbacks                Feedback[]
  createdAt                DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                 @updatedAt @db.Timestamptz(3)
  deletedAt                DateTime?                @db.Timestamptz(3)

  @@index([phone])
  @@index([passportExpiry])
  @@index([passportNumber])
  @@index([email])
  @@index([createdAt])
  @@index([searchVector], type: Gin)
  @@index([nationalityCode])
  @@index([countryOfResidenceCode])
  @@index([mergedIntoId])
}

/// A family member travelling with the patient.
model Attendant {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName         String
  relation         String?
  email            String?
  anonymizedAt     DateTime?         @db.Timestamptz(3)
  passportNumber   String?           @db.VarChar(32)
  passportExpiry   DateTime?         @db.Date
  dateOfBirth      DateTime?         @db.Date
  phone            String?           @db.VarChar(20)
  visaStatus       VisaStatus        @default(not_started)
  patientId        String            @db.Uuid
  patient          Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  userId           String?           @unique @db.Uuid
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  nationalityCode  String?           @db.Char(2)
  nationality      Country?          @relation(fields: [nationalityCode], references: [code], onDelete: Restrict)
  caseAttendants   CaseAttendant[]
  visaApplications VisaApplication[]
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?         @db.Timestamptz(3)

  @@index([patientId])
  @@index([nationalityCode])
}

/// Which attendants travel with the patient for a case.
model CaseAttendant {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  travelNotes String?   @db.Text
  caseId      String    @db.Uuid
  case        Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  attendantId String    @db.Uuid
  attendant   Attendant @relation(fields: [attendantId], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)

  @@unique([caseId, attendantId])
  @@index([attendantId])
}

/// What a patient agreed to, when, and whether they withdrew it. Hospital and agent sharing depend on these rows.
model Consent {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type            ConsentType
  grantedAt       DateTime         @default(now()) @db.Timestamptz(3)
  withdrawnAt     DateTime?        @db.Timestamptz(3)
  ip              String?          @db.VarChar(45)
  textVersion     String?          @db.VarChar(32)
  patientId       String           @db.Uuid
  patient         Patient          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  caseId          String?          @db.Uuid
  case            Case?            @relation(fields: [caseId], references: [id], onDelete: Restrict)
  hospitalId      String?          @db.Uuid
  hospital        Hospital?        @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  agentId         String?          @db.Uuid
  agent           Agent?           @relation(fields: [agentId], references: [id], onDelete: Restrict)
  documentShares  DocumentShare[]
  opinionRequests OpinionRequest[]
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?        @db.Timestamptz(3)

  @@index([patientId, type])
  @@index([caseId])
  @@index([hospitalId])
  @@index([agentId])
}

/// The central entity: one patient, one treatment episode. The stage changes only through CaseStageService (F-10).
model Case {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessions           Session[]
  caseNo             String             @unique
  stage              CaseStage          @default(enquiry)
  status             CaseStatus         @default(new)
  urgency            Urgency            @default(routine)
  budgetMinor        BigInt?
  source             CaseSource         @default(website)
  campaign           String?
  preferredLanguage  String?            @db.VarChar(8)
  stageEnteredAt     DateTime           @default(now()) @db.Timestamptz(3)
  plannedArrivalAt   DateTime?          @db.Timestamptz(3)
  plannedDepartureAt DateTime?          @db.Timestamptz(3)
  firstResponseDueAt DateTime?          @db.Timestamptz(3)
  firstRespondedAt   DateTime?          @db.Timestamptz(3)
  slaDueAt           DateTime?          @db.Timestamptz(3)
  slaBreachedAt      DateTime?          @db.Timestamptz(3)
  nextActionAt       DateTime?          @db.Timestamptz(3)
  closedAt           DateTime?          @db.Timestamptz(3)
  lostNote           String?            @db.Text
  budgetCurrency     String?            @db.Char(3)
  budgetCurrencyInfo Currency?          @relation("CaseBudgetCurrency", fields: [budgetCurrency], references: [code], onDelete: Restrict)
  patientId          String             @db.Uuid
  patient            Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  treatmentId        String?            @db.Uuid
  treatment          Treatment?         @relation(fields: [treatmentId], references: [id], onDelete: Restrict)
  preferredCityId    String?            @db.Uuid
  preferredCity      City?              @relation("CasePreferredCity", fields: [preferredCityId], references: [id], onDelete: Restrict)
  countryCode        String?            @db.Char(2)
  country            Country?           @relation(fields: [countryCode], references: [code], onDelete: Restrict)
  agentId            String?            @db.Uuid
  agent              Agent?             @relation(fields: [agentId], references: [id], onDelete: Restrict)
  ownerId            String?            @db.Uuid
  owner              User?              @relation("CaseOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  reviewerId         String?            @db.Uuid
  reviewer           User?              @relation("CaseReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  hospitalId         String?            @db.Uuid
  hospital           Hospital?          @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  lostReasonId       String?            @db.Uuid
  lostReason         LostReason?        @relation(fields: [lostReasonId], references: [id], onDelete: Restrict)
  caseAttendants     CaseAttendant[]
  consents           Consent[]
  stageHistory       CaseStageHistory[]
  medicalSummaries   MedicalSummary[]
  documents          Document[]
  caseIntake         CaseIntake?
  lead               Lead?
  caseNotes          CaseNote[]
  admissions         Admission[]
  opinionRequests    OpinionRequest[]
  quotes             Quote[]
  invoices           Invoice[]
  invoiceLines       InvoiceLine[]
  payments           Payment[]
  visaApplications   VisaApplication[]
  bookings           Booking[]
  commissions        Commission[]
  tasks              Task[]
  conversations      Conversation[]
  notifications      Notification[]
  feedback           Feedback?
  incidents          Incident[]
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?          @db.Timestamptz(3)

  @@index([status])
  @@index([createdAt])
  @@index([slaDueAt])
  @@index([stage, ownerId])
  @@index([stage, createdAt])
  @@index([plannedArrivalAt])
  @@index([closedAt])
  @@index([patientId])
  @@index([treatmentId])
  @@index([preferredCityId])
  @@index([countryCode])
  @@index([agentId])
  @@index([ownerId])
  @@index([reviewerId])
  @@index([hospitalId])
  @@index([lostReasonId])
}

/// Every stage change of a case, who made it and when.
model CaseStageHistory {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromStage CaseStage?
  toStage   CaseStage
  note      String?    @db.Text
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  caseId    String     @db.Uuid
  case      Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actorId   String?    @db.Uuid
  actor     User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
  @@index([actorId])
}

/// The reviewer's structured summary. One current version per case; older versions are kept.
model MedicalSummary {
  id                      String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version                 Int
  diagnosis               String           @db.Text
  findings                String?          @db.Text
  urgency                 Urgency?
  notes                   String?          @db.Text
  current                 Boolean          @default(true)
  createdAt               DateTime         @default(now()) @db.Timestamptz(3)
  caseId                  String           @db.Uuid
  case                    Case             @relation(fields: [caseId], references: [id], onDelete: Restrict)
  reviewerId              String?          @db.Uuid
  reviewer                User?            @relation(fields: [reviewerId], references: [id], onDelete: SetNull)
  recommendedSpecialityId String?          @db.Uuid
  recommendedSpeciality   Speciality?      @relation(fields: [recommendedSpecialityId], references: [id], onDelete: Restrict)
  opinionRequests         OpinionRequest[]

  @@unique([caseId, version])
  @@index([reviewerId])
  @@index([recommendedSpecialityId])
}

/// A file in the private bucket. Only metadata is here; downloads go through presigned URLs and are audited.
model Document {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind                 DocumentKind
  visibility           DocumentVisibility  @default(private)
  fileName             String
  mimeType             String              @db.VarChar(127)
  sizeBytes            Int
  storageKey           String              @unique
  checksum             String?             @db.VarChar(64)
  scanStatus           ScanStatus          @default(pending)
  /// When the scan finished (clean, infected or failed).
  scannedAt            DateTime?           @db.Timestamptz(3)
  /// Why a file is not clean: the virus signature, or `type_mismatch`.
  scanDetail           String?             @db.VarChar(200)
  pageCount            Int?
  /// Object key of the thumbnail in the private bucket.
  thumbnailKey         String?
  takenAt              DateTime?           @db.Date
  notes                String?             @db.Text
  patientId            String?             @db.Uuid
  patient              Patient?            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  caseId               String?             @db.Uuid
  case                 Case?               @relation(fields: [caseId], references: [id], onDelete: Restrict)
  agentId              String?             @db.Uuid
  agent                Agent?              @relation(fields: [agentId], references: [id], onDelete: Restrict)
  hospitalId           String?             @db.Uuid
  hospital             Hospital?           @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  typeId               String?             @db.Uuid
  type                 DocumentType?       @relation(fields: [typeId], references: [id], onDelete: Restrict)
  uploadedById         String?             @db.Uuid
  uploadedBy           User?               @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  shares               DocumentShare[]
  admissionsDischarged Admission[]
  accreditations       Accreditation[]
  hospitalAgreements   Hospital[]          @relation("HospitalAgreementDocument")
  quotes               Quote[]
  invoices             Invoice[]
  visaInvitations      VisaApplication[]
  messageAttachments   MessageAttachment[]
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @db.Timestamptz(3)
  deletedAt            DateTime?           @db.Timestamptz(3)

  @@index([kind])
  @@index([caseId, kind])
  @@index([patientId])
  @@index([agentId])
  @@index([hospitalId])
  @@index([typeId])
  @@index([uploadedById])
}

/// A patient-consented share of one document with one hospital. A hospital sees a document only through a live row here.
model DocumentShare {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revokedAt  DateTime? @db.Timestamptz(3)
  documentId String    @db.Uuid
  document   Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  hospitalId String    @db.Uuid
  hospital   Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  consentId  String    @db.Uuid
  consent    Consent   @relation(fields: [consentId], references: [id], onDelete: Restrict)
  sharedById String?   @db.Uuid
  sharedBy   User?     @relation(fields: [sharedById], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt  DateTime? @db.Timestamptz(3)

  @@unique([documentId, hospitalId])
  @@index([hospitalId])
  @@index([consentId])
  @@index([sharedById])
}

/// What the patient told us about their condition. Medical text: kept off the Case row so an agent's or a list query never carries it by accident.
model CaseIntake {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  condition   String    @db.Text
  history     String?   @db.Text
  medications String?   @db.Text
  caseId      String    @unique @db.Uuid
  case        Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)
}

/// A staff-only note on a case (Case 360 notes). Never shown to patients, hospitals or agents; messages to those people live in Message.
model CaseNote {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  body      String    @db.Text
  pinned    Boolean   @default(false)
  caseId    String    @db.Uuid
  case      Case      @relation(fields: [caseId], references: [id], onDelete: Restrict)
  authorId  String?   @db.Uuid
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([caseId, createdAt])
  @@index([authorId])
}

/// The treatment stay at a hospital: admission, surgery and discharge dates, and the estimate, running bill and final bill. Referral fees, commission and the bill-versus-estimate alert read these.
model Admission {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status              AdmissionStatus @default(planned)
  admittedAt          DateTime?       @db.Timestamptz(3)
  procedureAt         DateTime?       @db.Timestamptz(3)
  ward                String?
  expectedDischargeAt DateTime?       @db.Timestamptz(3)
  dischargedAt        DateTime?       @db.Timestamptz(3)
  fitToFlyAt          DateTime?       @db.Timestamptz(3)
  estimateMinor       BigInt?
  runningBillMinor    BigInt?
  finalBillMinor      BigInt?
  notes               String?         @db.Text
  caseId              String          @db.Uuid
  case                Case            @relation(fields: [caseId], references: [id], onDelete: Restrict)
  hospitalId          String          @db.Uuid
  hospital            Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  doctorId            String?         @db.Uuid
  doctor              Doctor?         @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  dischargeSummaryId  String?         @db.Uuid
  dischargeSummary    Document?       @relation(fields: [dischargeSummaryId], references: [id], onDelete: SetNull)
  currency            String?         @db.Char(3)
  currencyInfo        Currency?       @relation("AdmissionCurrency", fields: [currency], references: [code], onDelete: Restrict)
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(3)
  deletedAt           DateTime?       @db.Timestamptz(3)

  @@unique([caseId, hospitalId])
  @@index([status])
  @@index([admittedAt])
  @@index([expectedDischargeAt])
  @@index([hospitalId])
  @@index([doctorId])
  @@index([dischargeSummaryId])
}

/// Webhook events already handled (payment gateways, WhatsApp), so a replayed delivery is recognised and ignored.
model ProcessedWebhook {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider   String
  eventId    String
  payload    Json?
  receivedAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([provider, eventId])
}

/// A partner hospital. `agreementBp` is the referral-fee share in basis points (1250 = 12.5%). Bank details are stored encrypted by the application.
model Hospital {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                   String                   @unique
  name                   String
  status                 HospitalStatus           @default(draft)
  address                String?                  @db.Text
  website                String?
  phone                  String?                  @db.VarChar(20)
  email                  String?
  description            String?                  @db.Text
  internationalDeskName  String?
  internationalDeskEmail String?
  internationalDeskPhone String?                  @db.VarChar(20)
  agreementBp            Int?
  agreementStartsOn      DateTime?                @db.Date
  agreementEndsOn        DateTime?                @db.Date
  agreementDocumentId    String?                  @db.Uuid
  agreementDocument      Document?                @relation("HospitalAgreementDocument", fields: [agreementDocumentId], references: [id], onDelete: SetNull)
  bankDetails            Json?
  bedCount               Int?
  establishedYear        Int?
  latitude               Decimal?                 @db.Decimal(9, 6)
  longitude              Decimal?                 @db.Decimal(9, 6)
  publishedAt            DateTime?                @db.Timestamptz(3)
  searchVector           Unsupported("tsvector")?
  cityId                 String                   @db.Uuid
  city                   City                     @relation(fields: [cityId], references: [id], onDelete: Restrict)
  consents               Consent[]
  cases                  Case[]
  documents              Document[]
  documentShares         DocumentShare[]
  admissions             Admission[]
  branches               HospitalBranch[]
  staff                  HospitalStaff[]
  accreditations         Accreditation[]
  departments            Department[]
  doctors                Doctor[]
  translations           HospitalTranslation[]
  packages               Package[]
  opinionRequests        OpinionRequest[]
  invoices               Invoice[]
  stayDistances          StayHospitalDistance[]
  commissionRules        CommissionRule[]
  conversations          Conversation[]
  feedbacks              Feedback[]
  changeRequests         PartnerChangeRequest[]
  createdAt              DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                 @updatedAt @db.Timestamptz(3)
  deletedAt              DateTime?                @db.Timestamptz(3)

  @@index([status])
  @@index([searchVector], type: Gin)
  @@index([cityId])
  @@index([agreementDocumentId])
}

/// A branch of a hospital group, managed from one login.
model HospitalBranch {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  address        String?         @db.Text
  main           Boolean         @default(false)
  hospitalId     String          @db.Uuid
  hospital       Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  cityId         String          @db.Uuid
  city           City            @relation(fields: [cityId], references: [id], onDelete: Restrict)
  hospitalStaffs HospitalStaff[]
  doctors        Doctor[]
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?       @db.Timestamptz(3)

  @@index([hospitalId])
  @@index([cityId])
}

/// A hospital login: international desk staff or a doctor.
model HospitalStaff {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobTitle   String?
  userId     String          @db.Uuid
  user       User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  hospitalId String          @db.Uuid
  hospital   Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  branchId   String?         @db.Uuid
  branch     HospitalBranch? @relation(fields: [branchId], references: [id], onDelete: Restrict)
  doctorId   String?         @db.Uuid
  doctor     Doctor?         @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @db.Timestamptz(3)
  deletedAt  DateTime?       @db.Timestamptz(3)

  @@unique([userId, hospitalId])
  @@index([hospitalId])
  @@index([branchId])
  @@index([doctorId])
}

/// NABH, JCI and other accreditations, with the certificate and its expiry.
model Accreditation {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  body             AccreditationBody
  certificateNo    String?
  issuedAt         DateTime?         @db.Date
  expiresAt        DateTime?         @db.Date
  hospitalId       String            @db.Uuid
  hospital         Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  verifiedAt       DateTime?         @db.Timestamptz(3)
  verificationNote String?
  verifiedById     String?           @db.Uuid
  verifiedBy       User?             @relation("AccreditationVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  certificateId    String?           @db.Uuid
  certificate      Document?         @relation(fields: [certificateId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?         @db.Timestamptz(3)

  @@index([expiresAt])
  @@index([hospitalId])
  @@index([certificateId])
  @@index([verifiedById])
}

/// A speciality a hospital offers.
model Department {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String?
  hospitalId   String     @db.Uuid
  hospital     Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  specialityId String     @db.Uuid
  speciality   Speciality @relation(fields: [specialityId], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime?  @db.Timestamptz(3)

  @@unique([hospitalId, specialityId])
  @@index([specialityId])
}

/// A treating specialist at a hospital.
model Doctor {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                   String?                  @unique
  fullName               String
  qualifications         String?                  @db.Text
  experienceYears        Int?
  languages              String[]
  consultFeeMinor        BigInt?
  bio                    String?                  @db.Text
  published              Boolean                  @default(false)
  searchVector           Unsupported("tsvector")?
  consultFeeCurrency     String?                  @db.Char(3)
  consultFeeCurrencyInfo Currency?                @relation("DoctorConsultFeeCurrency", fields: [consultFeeCurrency], references: [code], onDelete: Restrict)
  hospitalId             String                   @db.Uuid
  hospital               Hospital                 @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  branchId               String?                  @db.Uuid
  branch                 HospitalBranch?          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  specialityId           String                   @db.Uuid
  speciality             Speciality               @relation(fields: [specialityId], references: [id], onDelete: Restrict)
  admissions             Admission[]
  hospitalStaffs         HospitalStaff[]
  translations           DoctorTranslation[]
  opinionRequests        OpinionRequest[]
  opinions               Opinion[]
  feedbacks              Feedback[]
  createdAt              DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                 @updatedAt @db.Timestamptz(3)
  deletedAt              DateTime?                @db.Timestamptz(3)

  @@index([searchVector], type: Gin)
  @@index([hospitalId])
  @@index([branchId])
  @@index([specialityId])
}

/// Doctor text in one language.
model DoctorTranslation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locale         String   @db.VarChar(8)
  fullName       String
  qualifications String?  @db.Text
  bio            String?  @db.Text
  doctorId       String   @db.Uuid
  doctor         Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@unique([doctorId, locale])
  @@index([locale])
}

/// Hospital text in one language.
model HospitalTranslation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locale      String   @db.VarChar(8)
  name        String
  description String?  @db.Text
  hospitalId  String   @db.Uuid
  hospital    Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([hospitalId, locale])
  @@index([locale])
}

/// A fixed-price package per procedure and room category; used by the cost estimator and the quote builder.
model Package {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  roomCategory   String?
  priceMinor     BigInt
  stayDays       Int?
  inclusions     String[]
  exclusions     String[]
  validFrom      DateTime?              @db.Date
  validUntil     DateTime?              @db.Date
  active         Boolean                @default(true)
  published      Boolean                @default(false)
  changeRequests PartnerChangeRequest[]
  hospitalId     String                 @db.Uuid
  hospital       Hospital               @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  treatmentId    String                 @db.Uuid
  treatment      Treatment              @relation(fields: [treatmentId], references: [id], onDelete: Restrict)
  currency       String                 @db.Char(3)
  currencyInfo   Currency               @relation("PackageCurrency", fields: [currency], references: [code], onDelete: Restrict)
  translations   PackageTranslation[]
  opinions       Opinion[]
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?              @db.Timestamptz(3)

  @@index([hospitalId, treatmentId])
  @@index([treatmentId])
}

/// Package text in one language.
model PackageTranslation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locale      String   @db.VarChar(8)
  name        String
  description String?  @db.Text
  packageId   String   @db.Uuid
  package     Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([packageId, locale])
  @@index([locale])
}

/// A case sent to one hospital for an opinion. One per case and hospital.
model OpinionRequest {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status        OpinionRequestStatus @default(draft)
  sentAt        DateTime?            @db.Timestamptz(3)
  dueAt         DateTime?            @db.Timestamptz(3)
  viewedAt      DateTime?            @db.Timestamptz(3)
  respondedAt   DateTime?            @db.Timestamptz(3)
  declineReason String?              @db.Text
  caseId        String               @db.Uuid
  case          Case                 @relation(fields: [caseId], references: [id], onDelete: Restrict)
  hospitalId    String               @db.Uuid
  hospital      Hospital             @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  doctorId      String?              @db.Uuid
  doctor        Doctor?              @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  summaryId     String?              @db.Uuid
  summary       MedicalSummary?      @relation(fields: [summaryId], references: [id], onDelete: SetNull)
  consentId     String?              @db.Uuid
  consent       Consent?             @relation(fields: [consentId], references: [id], onDelete: Restrict)
  sentById      String?              @db.Uuid
  sentBy        User?                @relation(fields: [sentById], references: [id], onDelete: SetNull)
  opinions      Opinion[]
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime?            @db.Timestamptz(3)

  @@index([caseId, hospitalId])
  @@index([hospitalId, status])
  @@index([dueAt])
  @@index([doctorId])
  @@index([summaryId])
  @@index([consentId])
  @@index([sentById])
}

/// The hospital's answer to an OpinionRequest: plan, doctor, stay, estimate.
model Opinion {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version          Int            @default(1)
  current          Boolean        @default(true)
  treatmentPlan    String         @db.Text
  stayDaysHospital Int?
  stayDaysOutside  Int?
  estimateMinor    BigInt
  inclusions       String[]
  exclusions       String[]
  validUntil       DateTime?      @db.Date
  opinionRequestId String         @db.Uuid
  opinionRequest   OpinionRequest @relation(fields: [opinionRequestId], references: [id], onDelete: Restrict)
  doctorId         String?        @db.Uuid
  doctor           Doctor?        @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  packageId        String?        @db.Uuid
  package          Package?       @relation(fields: [packageId], references: [id], onDelete: Restrict)
  submittedById    String?        @db.Uuid
  submittedBy      User?          @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  currency         String         @db.Char(3)
  currencyInfo     Currency       @relation("OpinionCurrency", fields: [currency], references: [code], onDelete: Restrict)
  quotes           Quote[]
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?      @db.Timestamptz(3)

  @@unique([opinionRequestId, version])
  @@index([doctorId])
  @@index([packageId])
  @@index([submittedById])
}

/// What we offer the patient. Stores the exchange rate it was priced with.
model Quote {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteNo            String      @unique
  status             QuoteStatus @default(draft)
  totalMinor         BigInt
  version            Int         @default(1)
  fxRate             Decimal?    @db.Decimal(18, 8)
  fxRateAt           DateTime?   @db.Timestamptz(3)
  fxSource           String?
  marginBp           Int?
  validUntil         DateTime?   @db.Date
  sentAt             DateTime?   @db.Timestamptz(3)
  viewedAt           DateTime?   @db.Timestamptz(3)
  acceptedAt         DateTime?   @db.Timestamptz(3)
  caseId             String      @db.Uuid
  case               Case        @relation(fields: [caseId], references: [id], onDelete: Restrict)
  opinionId          String?     @db.Uuid
  opinion            Opinion?    @relation(fields: [opinionId], references: [id], onDelete: Restrict)
  acceptedById       String?     @db.Uuid
  acceptedBy         User?       @relation("QuoteAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  createdById        String?     @db.Uuid
  createdBy          User?       @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  pdfId              String?     @db.Uuid
  pdf                Document?   @relation(fields: [pdfId], references: [id], onDelete: SetNull)
  currency           String      @db.Char(3)
  currencyInfo       Currency    @relation("QuoteCurrency", fields: [currency], references: [code], onDelete: Restrict)
  fxBaseCurrency     String?     @db.Char(3)
  fxBaseCurrencyInfo Currency?   @relation("QuoteFxBaseCurrency", fields: [fxBaseCurrency], references: [code], onDelete: Restrict)
  lines              QuoteLine[]
  payments           Payment[]
  createdAt          DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?   @db.Timestamptz(3)

  @@unique([caseId, version])
  @@index([status])
  @@index([validUntil])
  @@index([opinionId])
  @@index([acceptedById])
  @@index([createdById])
  @@index([pdfId])
}

/// One line of a quote; `costMinor` is our cost, kept for the profit report.
model QuoteLine {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind           QuoteLineKind
  description    String
  quantity       Int           @default(1)
  unitPriceMinor BigInt
  amountMinor    BigInt
  costMinor      BigInt?
  sortOrder      Int           @default(0)
  quoteId        String        @db.Uuid
  quote          Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  currency       String        @db.Char(3)
  currencyInfo   Currency      @relation("QuoteLineCurrency", fields: [currency], references: [code], onDelete: Restrict)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  @@index([quoteId])
}

/// GST invoice for our fees (to a patient) or a referral fee (to a hospital). Numbers look like INV/26-27/00001.
model Invoice {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceNo        String        @unique
  supplierGstin    String?       @db.VarChar(15)
  exportOfServices Boolean       @default(false)
  disputedAt       DateTime?     @db.Timestamptz(3)
  disputeNote      String?       @db.Text
  kind             InvoiceKind
  status           InvoiceStatus @default(draft)
  subtotalMinor    BigInt
  taxMinor         BigInt        @default(0)
  totalMinor       BigInt
  gstin            String?       @db.VarChar(15)
  placeOfSupply    String?
  billToName       String
  billToAddress    String?       @db.Text
  issuedAt         DateTime?     @db.Timestamptz(3)
  dueAt            DateTime?     @db.Timestamptz(3)
  paidAt           DateTime?     @db.Timestamptz(3)
  caseId           String?       @db.Uuid
  case             Case?         @relation(fields: [caseId], references: [id], onDelete: Restrict)
  hospitalId       String?       @db.Uuid
  hospital         Hospital?     @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  pdfId            String?       @db.Uuid
  pdf              Document?     @relation(fields: [pdfId], references: [id], onDelete: SetNull)
  currency         String        @db.Char(3)
  currencyInfo     Currency      @relation("InvoiceCurrency", fields: [currency], references: [code], onDelete: Restrict)
  lines            InvoiceLine[]
  creditNotes      CreditNote[]
  payments         Payment[]
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?     @db.Timestamptz(3)

  @@index([status])
  @@index([issuedAt])
  @@index([status, dueAt])
  @@index([caseId])
  @@index([hospitalId])
  @@index([pdfId])
}

model InvoiceLine {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sacCode        String?  @db.VarChar(8)
  cgstMinor      BigInt   @default(0)
  sgstMinor      BigInt   @default(0)
  igstMinor      BigInt   @default(0)
  description    String
  quantity       Int      @default(1)
  unitPriceMinor BigInt
  taxRateBp      Int      @default(0)
  taxMinor       BigInt   @default(0)
  amountMinor    BigInt
  sortOrder      Int      @default(0)
  invoiceId      String   @db.Uuid
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  caseId         String?  @db.Uuid
  case           Case?    @relation(fields: [caseId], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@index([invoiceId])
  @@index([caseId])
}

/// Reduces an invoice.
model CreditNote {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creditNoteNo String           @unique
  status       CreditNoteStatus @default(draft)
  reason       String           @db.Text
  amountMinor  BigInt
  taxMinor     BigInt           @default(0)
  issuedAt     DateTime?        @db.Timestamptz(3)
  invoiceId    String           @db.Uuid
  invoice      Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  currency     String           @db.Char(3)
  currencyInfo Currency         @relation("CreditNoteCurrency", fields: [currency], references: [code], onDelete: Restrict)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime?        @db.Timestamptz(3)

  @@index([invoiceId])
}

/// Money received. `pass_through` payments (hospital deposits) are a liability, not revenue.
model Payment {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type           PaymentType
  method         PaymentMethod
  status         PaymentStatus @default(pending)
  amountMinor    BigInt
  amountInrMinor BigInt?
  fxRate         Decimal?      @db.Decimal(18, 8)
  gateway        String?
  gatewayRef     String?
  payerName      String?
  failureReason  String?       @db.Text
  paidAt         DateTime?     @db.Timestamptz(3)
  caseId         String?       @db.Uuid
  case           Case?         @relation(fields: [caseId], references: [id], onDelete: Restrict)
  invoiceId      String?       @db.Uuid
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  quoteId        String?       @db.Uuid
  quote          Quote?        @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  currency       String        @db.Char(3)
  currencyInfo   Currency      @relation("PaymentCurrency", fields: [currency], references: [code], onDelete: Restrict)
  refunds        Refund[]
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?     @db.Timestamptz(3)

  @@unique([gateway, gatewayRef])
  @@index([status])
  @@index([paidAt])
  @@index([type, status])
  @@index([caseId])
  @@index([invoiceId])
  @@index([quoteId])
}

/// A request to give money back, with who approved it.
model Refund {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status        RefundStatus @default(requested)
  amountMinor   BigInt
  reason        String       @db.Text
  gatewayRef    String?
  processedAt   DateTime?    @db.Timestamptz(3)
  paymentId     String       @db.Uuid
  payment       Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  requestedById String?      @db.Uuid
  requestedBy   User?        @relation("RefundRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedById  String?      @db.Uuid
  approvedBy    User?        @relation("RefundApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  currency      String       @db.Char(3)
  currencyInfo  Currency     @relation("RefundCurrency", fields: [currency], references: [code], onDelete: Restrict)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime?    @db.Timestamptz(3)

  @@index([status])
  @@index([paymentId])
  @@index([requestedById])
  @@index([approvedById])
}

/// Visa tracker row for one traveller (the patient or an attendant) of a case.
model VisaApplication {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type               VisaType   @default(medical)
  status             VisaStatus @default(not_started)
  applicationId      String?
  appliedAt          DateTime?  @db.Timestamptz(3)
  decisionAt         DateTime?  @db.Timestamptz(3)
  expiresAt          DateTime?  @db.Date
  notes              String?    @db.Text
  caseId             String     @db.Uuid
  case               Case       @relation(fields: [caseId], references: [id], onDelete: Restrict)
  patientId          String?    @db.Uuid
  patient            Patient?   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  attendantId        String?    @db.Uuid
  attendant          Attendant? @relation(fields: [attendantId], references: [id], onDelete: Restrict)
  invitationLetterId String?    @db.Uuid
  invitationLetter   Document?  @relation(fields: [invitationLetterId], references: [id], onDelete: SetNull)
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?  @db.Timestamptz(3)

  @@index([status])
  @@index([expiresAt])
  @@index([caseId])
  @@index([patientId])
  @@index([attendantId])
  @@index([invitationLetterId])
}

/// A supplier of stays, transport, interpreters, SIMs or travel.
model Vendor {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind        VendorKind
  name        String
  contactName String?
  phone       String?    @db.VarChar(20)
  email       String?
  gstin       String?    @db.VarChar(15)
  active      Boolean    @default(true)
  cityId      String?    @db.Uuid
  city        City?      @relation(fields: [cityId], references: [id], onDelete: Restrict)
  stays       Stay[]
  drivers     Driver[]
  vehicles    Vehicle[]
  bookings    Booking[]
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?  @db.Timestamptz(3)

  @@index([kind])
  @@index([cityId])
}

/// A partner guest house, hotel or service apartment.
model Stay {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type                 StayType
  name                 String
  address              String?                @db.Text
  latitude             Decimal?               @db.Decimal(9, 6)
  longitude            Decimal?               @db.Decimal(9, 6)
  halalKitchen         Boolean                @default(false)
  wheelchairAccessible Boolean                @default(false)
  notes                String?                @db.Text
  active               Boolean                @default(true)
  vendorId             String?                @db.Uuid
  vendor               Vendor?                @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  cityId               String                 @db.Uuid
  city                 City                   @relation(fields: [cityId], references: [id], onDelete: Restrict)
  rooms                StayRoom[]
  distances            StayHospitalDistance[]
  bookings             Booking[]
  createdAt            DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime               @updatedAt @db.Timestamptz(3)
  deletedAt            DateTime?              @db.Timestamptz(3)

  @@index([vendorId])
  @@index([cityId])
}

model StayRoom {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomType          String
  ratePerNightMinor BigInt
  capacity          Int      @default(1)
  quantity          Int      @default(1)
  stayId            String   @db.Uuid
  stay              Stay     @relation(fields: [stayId], references: [id], onDelete: Cascade)
  currency          String   @db.Char(3)
  currencyInfo      Currency @relation("StayRoomCurrency", fields: [currency], references: [code], onDelete: Restrict)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  @@index([stayId])
}

/// How far a stay is from a hospital.
model StayHospitalDistance {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  distanceKm Decimal  @db.Decimal(5, 1)
  stayId     String   @db.Uuid
  stay       Stay     @relation(fields: [stayId], references: [id], onDelete: Cascade)
  hospitalId String   @db.Uuid
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@unique([stayId, hospitalId])
  @@index([hospitalId])
}

model Driver {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName  String
  phone     String    @db.VarChar(20)
  licenseNo String?
  active    Boolean   @default(true)
  vendorId  String?   @db.Uuid
  vendor    Vendor?   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  cityId    String?   @db.Uuid
  city      City?     @relation(fields: [cityId], references: [id], onDelete: Restrict)
  vehicles  Vehicle[]
  bookings  Booking[]
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([vendorId])
  @@index([cityId])
}

model Vehicle {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type           VehicleType
  registrationNo String      @unique
  capacity       Int         @default(4)
  active         Boolean     @default(true)
  vendorId       String?     @db.Uuid
  vendor         Vendor?     @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  driverId       String?     @db.Uuid
  driver         Driver?     @relation(fields: [driverId], references: [id], onDelete: Restrict)
  cityId         String?     @db.Uuid
  city           City?       @relation(fields: [cityId], references: [id], onDelete: Restrict)
  bookings       Booking[]
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?   @db.Timestamptz(3)

  @@index([vendorId])
  @@index([driverId])
  @@index([cityId])
}

model Interpreter {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName               String
  phone                  String?               @db.VarChar(20)
  employment             InterpreterEmployment @default(in_house)
  languages              String[]
  hourlyRateMinor        BigInt?
  active                 Boolean               @default(true)
  hourlyRateCurrency     String?               @db.Char(3)
  hourlyRateCurrencyInfo Currency?             @relation("InterpreterHourlyRateCurrency", fields: [hourlyRateCurrency], references: [code], onDelete: Restrict)
  userId                 String?               @unique @db.Uuid
  user                   User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  cityId                 String?               @db.Uuid
  city                   City?                 @relation(fields: [cityId], references: [id], onDelete: Restrict)
  bookings               Booking[]
  createdAt              DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime              @updatedAt @db.Timestamptz(3)
  deletedAt              DateTime?             @db.Timestamptz(3)

  @@index([cityId])
}

/// A flight, stay, transfer, interpreter, SIM or other booking for a case (the logistics board reads these).
model Booking {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          BookingType
  status        BookingStatus @default(requested)
  startsAt      DateTime      @db.Timestamptz(3)
  endsAt        DateTime?     @db.Timestamptz(3)
  costMinor     BigInt?
  priceMinor    BigInt?
  reference     String?
  details       Json?
  notes         String?       @db.Text
  currency      String?       @db.Char(3)
  currencyInfo  Currency?     @relation("BookingCurrency", fields: [currency], references: [code], onDelete: Restrict)
  caseId        String        @db.Uuid
  case          Case          @relation(fields: [caseId], references: [id], onDelete: Restrict)
  vendorId      String?       @db.Uuid
  vendor        Vendor?       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  stayId        String?       @db.Uuid
  stay          Stay?         @relation(fields: [stayId], references: [id], onDelete: Restrict)
  driverId      String?       @db.Uuid
  driver        Driver?       @relation(fields: [driverId], references: [id], onDelete: Restrict)
  vehicleId     String?       @db.Uuid
  vehicle       Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  interpreterId String?       @db.Uuid
  interpreter   Interpreter?  @relation(fields: [interpreterId], references: [id], onDelete: Restrict)
  cityId        String?       @db.Uuid
  city          City?         @relation(fields: [cityId], references: [id], onDelete: Restrict)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime?     @db.Timestamptz(3)

  @@index([type, startsAt])
  @@index([status])
  @@index([startsAt])
  @@index([cityId, startsAt])
  @@index([caseId])
  @@index([vendorId])
  @@index([stayId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([interpreterId])
}

/// A referral partner. KYC documents are Documents with this agent. Payout details are stored encrypted by the application.
model Agent {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyName      String
  contactName      String?
  phone            String?         @db.VarChar(20)
  email            String?
  status           AgentStatus     @default(applied)
  tier             AgentTier       @default(silver)
  referralCode     String          @unique
  languages        String[]
  payoutDetails    Json?
  approvedAt       DateTime?       @db.Timestamptz(3)
  countryCode      String          @db.Char(2)
  country          Country         @relation(fields: [countryCode], references: [code], onDelete: Restrict)
  commissionPlanId String?         @db.Uuid
  commissionPlan   CommissionPlan? @relation(fields: [commissionPlanId], references: [id], onDelete: Restrict)
  agentUsers       AgentUser[]
  consents         Consent[]
  cases            Case[]
  documents        Document[]
  commissions      Commission[]
  payouts          Payout[]
  conversations    Conversation[]
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?       @db.Timestamptz(3)

  @@index([status])
  @@index([countryCode])
  @@index([commissionPlanId])
}

/// How much of the hospital fee an agent earns.
model CommissionPlan {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  defaultRateBp Int
  active        Boolean          @default(true)
  agents        Agent[]
  rules         CommissionRule[]
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime?        @db.Timestamptz(3)
}

/// Overrides the plan's default for one hospital and/or treatment.
model CommissionRule {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rateBp        Int
  effectiveFrom DateTime?      @db.Date
  effectiveTo   DateTime?      @db.Date
  planId        String         @db.Uuid
  plan          CommissionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  hospitalId    String?        @db.Uuid
  hospital      Hospital?      @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  treatmentId   String?        @db.Uuid
  treatment     Treatment?     @relation(fields: [treatmentId], references: [id], onDelete: Restrict)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)

  @@index([planId])
  @@index([hospitalId])
  @@index([treatmentId])
}

/// What an agent earned on a case, once the hospital fee is received.
model Commission {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  basisMinor   BigInt
  rateBp       Int
  amountMinor  BigInt
  tdsMinor     BigInt           @default(0)
  status       CommissionStatus @default(earned)
  earnedAt     DateTime         @default(now()) @db.Timestamptz(3)
  approvedAt   DateTime?        @db.Timestamptz(3)
  caseId       String           @db.Uuid
  case         Case             @relation(fields: [caseId], references: [id], onDelete: Restrict)
  agentId      String           @db.Uuid
  agent        Agent            @relation(fields: [agentId], references: [id], onDelete: Restrict)
  payoutId     String?          @db.Uuid
  payout       Payout?          @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  currency     String           @db.Char(3)
  currencyInfo Currency         @relation("CommissionCurrency", fields: [currency], references: [code], onDelete: Restrict)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime?        @db.Timestamptz(3)

  @@index([caseId, agentId])
  @@index([status])
  @@index([agentId])
  @@index([payoutId])
}

/// Money sent to an agent for approved commissions.
model Payout {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  method       PayoutMethod
  status       PayoutStatus @default(requested)
  amountMinor  BigInt
  requestedAt  DateTime     @default(now()) @db.Timestamptz(3)
  paidAt       DateTime?    @db.Timestamptz(3)
  reference    String?
  batchRef     String?
  agentId      String       @db.Uuid
  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Restrict)
  currency     String       @db.Char(3)
  currencyInfo Currency     @relation("PayoutCurrency", fields: [currency], references: [code], onDelete: Restrict)
  commissions  Commission[]
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime?    @db.Timestamptz(3)

  @@index([status])
  @@index([agentId])
}

/// A to-do for a person, usually on a case. Some are created automatically on stage changes (`autoKey`).
model Task {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  description  String?      @db.Text
  dueAt        DateTime?    @db.Timestamptz(3)
  status       TaskStatus   @default(open)
  priority     TaskPriority @default(normal)
  autoKey      String?
  assigneeRole Role?
  completedAt  DateTime?    @db.Timestamptz(3)
  caseId       String?      @db.Uuid
  case         Case?        @relation(fields: [caseId], references: [id], onDelete: Restrict)
  assigneeId   String?      @db.Uuid
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdById  String?      @db.Uuid
  createdBy    User?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime?    @db.Timestamptz(3)

  @@index([assigneeId, status, dueAt])
  @@index([dueAt])
  @@index([caseId])
  @@index([createdById])
}

/// A thread: with the patient, a hospital, an agent, or internal.
model Conversation {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind          ConversationKind
  subject       String?
  lastMessageAt DateTime?        @db.Timestamptz(3)
  caseId        String?          @db.Uuid
  case          Case?            @relation(fields: [caseId], references: [id], onDelete: Restrict)
  hospitalId    String?          @db.Uuid
  hospital      Hospital?        @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  agentId       String?          @db.Uuid
  agent         Agent?           @relation(fields: [agentId], references: [id], onDelete: Restrict)
  messages      Message[]
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime?        @db.Timestamptz(3)

  @@index([caseId, lastMessageAt])
  @@index([hospitalId])
  @@index([agentId])
}

/// One message in a conversation. Message text can contain medical information: never logged.
model Message {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channel        MessageChannel
  direction      MessageDirection
  senderLabel    String?
  body           String              @db.Text
  bodyTranslated String?             @db.Text
  language       String?             @db.VarChar(8)
  externalId     String?
  deliveredAt    DateTime?           @db.Timestamptz(3)
  readAt         DateTime?           @db.Timestamptz(3)
  conversationId String              @db.Uuid
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  senderId       String?             @db.Uuid
  sender         User?               @relation(fields: [senderId], references: [id], onDelete: SetNull)
  attachments    MessageAttachment[]
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?           @db.Timestamptz(3)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model MessageAttachment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  messageId  String   @db.Uuid
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  documentId String   @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([messageId, documentId])
  @@index([documentId])
}

/// A message the system sent to a user. In-app ones are what the bell shows.
model Notification {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channel           NotificationChannel
  status            NotificationStatus  @default(queued)
  /// Makes a repeated delivery of the same event a no-op: one notification per key.
  dedupeKey         String?             @unique
  templateKey       String
  title             String?
  body              String?             @db.Text
  data              Json?
  /// Language the message was written in.
  locale            String?             @db.VarChar(8)
  /// Adapter that carried it (`smtp`, `msg91`, `twilio`, `meta`, `dev`, `in_app`).
  provider          String?             @db.VarChar(40)
  /// The provider's id for the message, used to match its delivery callbacks.
  providerMessageId String?             @db.VarChar(200)
  attempts          Int                 @default(0)
  lastError         String?             @db.VarChar(500)
  sentAt            DateTime?           @db.Timestamptz(3)
  deliveredAt       DateTime?           @db.Timestamptz(3)
  readAt            DateTime?           @db.Timestamptz(3)
  failedAt          DateTime?           @db.Timestamptz(3)
  userId            String              @db.Uuid
  user              User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  caseId            String?             @db.Uuid
  case              Case?               @relation(fields: [caseId], references: [id], onDelete: Restrict)
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime?           @db.Timestamptz(3)

  @@index([userId, status])
  @@index([userId, readAt])
  @@index([caseId])
  @@index([providerMessageId])
  @@index([createdAt, id])
  @@index([templateKey])
  @@index([userId, channel, createdAt(sort: Desc), id(sort: Desc)])
}

/// Whether a person wants messages on a channel. No row means yes. In-app messages and security alerts cannot be switched off.
model NotificationPreference {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String              @db.Uuid
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  enabled   Boolean             @default(true)
  createdAt DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt DateTime            @updatedAt @db.Timestamptz(3)

  @@unique([userId, channel])
}

/// A patient's ratings of a finished case; 1 to 5.
model Feedback {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospitalRating    Int?
  doctorRating      Int?
  coordinatorRating Int?
  stayRating        Int?
  comment           String?   @db.Text
  publicConsent     Boolean   @default(false)
  caseId            String    @unique @db.Uuid
  case              Case      @relation(fields: [caseId], references: [id], onDelete: Restrict)
  patientId         String    @db.Uuid
  patient           Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  hospitalId        String?   @db.Uuid
  hospital          Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  doctorId          String?   @db.Uuid
  doctor            Doctor?   @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime? @db.Timestamptz(3)

  @@index([patientId])
  @@index([hospitalId])
  @@index([doctorId])
}

/// A complaint, complication or lost document, with escalation to a manager.
model Incident {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          IncidentType
  severity      IncidentSeverity @default(medium)
  status        IncidentStatus   @default(open)
  description   String           @db.Text
  resolution    String?          @db.Text
  resolvedAt    DateTime?        @db.Timestamptz(3)
  caseId        String?          @db.Uuid
  case          Case?            @relation(fields: [caseId], references: [id], onDelete: Restrict)
  reportedById  String?          @db.Uuid
  reportedBy    User?            @relation("IncidentReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  assigneeId    String?          @db.Uuid
  assignee      User?            @relation("IncidentAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  escalatedToId String?          @db.Uuid
  escalatedTo   User?            @relation("IncidentEscalatedTo", fields: [escalatedToId], references: [id], onDelete: Restrict)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime?        @db.Timestamptz(3)

  @@index([status, severity])
  @@index([caseId])
  @@index([reportedById])
  @@index([assigneeId])
  @@index([escalatedToId])
}

/// Who did or viewed what, when and from where. Append-only (a trigger rejects updates) and deliberately without foreign keys, so it outlives what it describes.
model AuditEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId      String?  @db.Uuid
  actorRole    String?  @db.VarChar(32)
  action       String
  entityType   String
  entityId     String
  patientId    String?  @db.Uuid
  /// Set when a super admin was looking at the product as this user (impersonation); the actor is then the admin.
  onBehalfOfId String?  @db.Uuid
  before       Json?
  after        Json?
  ip           String?  @db.VarChar(45)
  userAgent    String?
  requestId    String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@index([actorId, createdAt])
  @@index([patientId, createdAt])
  @@index([onBehalfOfId, createdAt])
  @@index([createdAt])
}

/// Domain events written in the same transaction as the change that caused them; the worker delivers them (notifications, audit, SLA timers).
model OutboxEvent {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dedupeKey     String?      @unique
  type          String
  aggregateType String
  aggregateId   String
  payload       Json
  status        OutboxStatus @default(pending)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @db.Timestamptz(3)
  processedAt   DateTime?    @db.Timestamptz(3)
  lastError     String?      @db.Text
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)

  @@index([status, availableAt])
  @@index([processedAt])
  @@index([aggregateType, aggregateId])
}

/// Gap-free counters for human-readable numbers: CASE-YYYY-NNNNNN, INV/YY-YY/NNNNN, Q-NNNNNN. Incremented inside the transaction that uses the number.
model NumberSequence {
  key    String
  period String @db.VarChar(16)
  value  Int    @default(0)

  @@id([key, period])
}

/// One browser upload of a file to the private bucket. The API creates it when it signs the start of the multipart upload
/// and only signs later requests for keys it knows, for the same user, while it is open.
model FileUpload {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Object key in the private bucket, chosen by the API (`files/<uuid>`); never the file name.
  key         String             @unique
  /// S3 multipart upload id, set when the first part is signed.
  uploadId    String?
  status      FileUploadStatus   @default(open)
  fileName    String
  mimeType    String             @db.VarChar(127)
  sizeBytes   Int
  kind        DocumentKind       @default(other)
  visibility  DocumentVisibility @default(private)
  typeId      String?            @db.Uuid
  caseId      String?            @db.Uuid
  patientId   String?            @db.Uuid
  hospitalId  String?            @db.Uuid
  expiresAt   DateTime           @db.Timestamptz(3)
  completedAt DateTime?          @db.Timestamptz(3)
  documentId  String?            @unique @db.Uuid
  userId      String             @db.Uuid
  user        User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)

  @@index([userId, status])
  @@index([status, expiresAt])
}

/// What an admin changed about a stage: its target time, owner role and automatic tasks. A stage with no row uses the defaults in
/// `packages/contracts` (`DEFAULT_STAGE_TARGET_MINUTES`, `STAGE_OWNER_ROLE`, `DEFAULT_AUTO_TASKS`).
model StageConfig {
  stage         CaseStage @id
  targetMinutes Int?
  ownerRole     Role
  autoTasks     Json      @default("[]")
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  updatedById   String?   @db.Uuid
}

/// Where daily exchange rates come from.
enum FxProvider {
  static
  frankfurter
  openexchangerates
}

/// What a price list entry is: one of the three service packages, or an add-on.
enum PriceItemKind {
  service_package
  add_on
}

/// A thing we put a price on: Basic, Standard or Premium service, or an add-on (extra night, interpreter hour, SIM).
/// The prices live in versions; changing a price adds a version and never edits an old one.
model PriceItem {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind       PriceItemKind
  code       String             @unique
  name       String
  /// What one price buys for an add-on: night, hour, item, trip.
  unit       String?
  inclusions String[]
  sortOrder  Int                @default(0)
  active     Boolean            @default(true)
  versions   PriceItemVersion[]
  createdAt  DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime           @updatedAt @db.Timestamptz(3)
  deletedAt  DateTime?          @db.Timestamptz(3)

  @@index([kind, sortOrder])
}

/// One published set of prices for an item. The newest version is the current price list; older ones stay for history.
model PriceItemVersion {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version     Int
  note        String?
  itemId      String           @db.Uuid
  item        PriceItem        @relation(fields: [itemId], references: [id], onDelete: Restrict)
  createdById String?          @db.Uuid
  createdBy   User?            @relation("PriceItemVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  prices      PriceItemPrice[]
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)

  @@unique([itemId, version])
  @@index([createdById])
}

/// The price in one currency within a version. A currency with no row is converted from the INR price at the current rate.
model PriceItemPrice {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  amountMinor  BigInt
  versionId    String           @db.Uuid
  version      PriceItemVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  currency     String           @db.Char(3)
  currencyInfo Currency         @relation("PriceItemPriceCurrency", fields: [currency], references: [code], onDelete: Restrict)

  @@unique([versionId, currency])
}

/// Our margin on one kind of quote line, in basis points of cost. One row per component.
model MarginRule {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  component   QuoteLineKind @unique
  marginBp    Int
  updatedById String?       @db.Uuid
  updatedBy   User?         @relation("MarginRuleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  @@index([updatedById])
}

/// The biggest discount (basis points of the quote) a role may give without someone above them approving it.
model DiscountThreshold {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role        Role     @unique
  maxBp       Int
  updatedById String?  @db.Uuid
  updatedBy   User?    @relation("DiscountThresholdUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([updatedById])
}

/// Exchange-rate settings; always one row with id `default`. A null provider means the environment's FX_PROVIDER.
model FxSetting {
  id          String      @id
  provider    FxProvider?
  markupBp    Int         @default(0)
  updatedById String?     @db.Uuid
  updatedBy   User?       @relation("FxSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)

  @@index([updatedById])
}

/// A rate set by hand instead of the provider's: 1 base = rate quote, with a reason, until it expires or is removed.
model FxOverride {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rate              Decimal   @db.Decimal(18, 8)
  reason            String
  expiresAt         DateTime? @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  baseCurrency      String    @db.Char(3)
  baseCurrencyInfo  Currency  @relation("FxOverrideBase", fields: [baseCurrency], references: [code], onDelete: Restrict)
  quoteCurrency     String    @db.Char(3)
  quoteCurrencyInfo Currency  @relation("FxOverrideQuote", fields: [quoteCurrency], references: [code], onDelete: Restrict)
  createdById       String?   @db.Uuid
  createdBy         User?     @relation("FxOverrideCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)

  @@index([baseCurrency, quoteCurrency])
  @@index([createdById])
}

/// What a partner asks us to approve.
enum ChangeRequestKind {
  hospital_onboarding
  hospital_profile
  package_price
}

enum ChangeRequestStatus {
  pending
  approved
  rejected
  withdrawn
}

/// A hospital's submission for review: the first onboarding, an edit to its profile, or a new package price. `current` is what
/// the fields held when it was submitted and `proposed` what the hospital wants; approving applies `proposed` in one transaction.
model PartnerChangeRequest {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind           ChangeRequestKind
  status         ChangeRequestStatus @default(pending)
  current        Json
  proposed       Json
  note           String?
  decisionReason String?
  decidedAt      DateTime?           @db.Timestamptz(3)
  hospitalId     String              @db.Uuid
  hospital       Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  packageId      String?             @db.Uuid
  package        Package?            @relation(fields: [packageId], references: [id], onDelete: Restrict)
  submittedById  String?             @db.Uuid
  submittedBy    User?               @relation("ChangeRequestSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  decidedById    String?             @db.Uuid
  decidedBy      User?               @relation("ChangeRequestDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?           @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([hospitalId])
  @@index([packageId])
  @@index([submittedById])
  @@index([decidedById])
}

/// Where a lead stands on being a duplicate of someone we already know.
enum DuplicateState {
  none
  possible
  dismissed
  merged
}

/// One enquiry as it arrived, from any source. The case is the work item; the lead keeps how it got here and what was submitted.
/// Personal data: never logged.
model Lead {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source               CaseSource
  utmSource            String?
  utmMedium            String?
  utmCampaign          String?
  referrer             String?
  agentCode            String?
  language             String?        @db.VarChar(8)
  message              String?        @db.Text
  submittedName        String
  submittedEmail       String?
  submittedPhone       String?        @db.VarChar(20)
  submittedPassport    String?        @db.VarChar(32)
  matchedOn            String[]
  duplicateState       DuplicateState @default(none)
  duplicateOfPatientId String?        @db.Uuid
  duplicateOfPatient   Patient?       @relation("LeadDuplicateOf", fields: [duplicateOfPatientId], references: [id], onDelete: SetNull)
  patientId            String         @db.Uuid
  patient              Patient        @relation("LeadPatient", fields: [patientId], references: [id], onDelete: Restrict)
  caseId               String         @unique @db.Uuid
  case                 Case           @relation(fields: [caseId], references: [id], onDelete: Restrict)
  createdById          String?        @db.Uuid
  createdBy            User?          @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @db.Timestamptz(3)
  deletedAt            DateTime?      @db.Timestamptz(3)

  @@index([duplicateState, createdAt])
  @@index([patientId])
  @@index([duplicateOfPatientId])
  @@index([createdById])
  @@index([source, createdAt])
}
