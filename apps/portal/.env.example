# Base URL of the API, used by the generated client in the browser.
NEXT_PUBLIC_API_URL="http://localhost:3001"
PORT=3002

# Serves /ui-gallery and its mock storage endpoint (/api/ui-gallery/s3). Development and CI only:
# leave it unset (off) on any deployed environment. Next 404s both routes unless it is "true".
ENABLE_UI_GALLERY=true


# Error reporting (Sentry). Leave empty to send nothing. The release build also sets SENTRY_AUTH_TOKEN, SENTRY_ORG,
# SENTRY_PROJECT_PORTAL and SENTRY_RELEASE to upload source maps and tag the release.
NEXT_PUBLIC_SENTRY_DSN=
