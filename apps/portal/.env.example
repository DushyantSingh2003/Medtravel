# Base URL of the API, used by the generated client in the browser.
NEXT_PUBLIC_API_URL="http://localhost:3001"
PORT=3002

# Serves /ui-gallery and its mock storage endpoint (/api/ui-gallery/s3). Development and CI only:
# leave it unset (off) on any deployed environment. Next 404s both routes unless it is "true".
ENABLE_UI_GALLERY=true

# Stub sign-in: /login lets you pick any role until real authentication (F-03) exists. Development
# and CI only: leave it unset (off) on any deployed environment. Without it every portal page
# redirects to a login page that says sign-in is not available.
ENABLE_STUB_AUTH=true
