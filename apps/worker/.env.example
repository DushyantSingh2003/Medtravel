NODE_ENV=development
LOG_LEVEL=debug

DATABASE_URL="postgresql://medtravel:medtravel@localhost:5432/medtravel?schema=public"
REDIS_URL="redis://localhost:6379"

# How many jobs one worker process handles at a time.
WORKER_CONCURRENCY=5

# --- object storage (MinIO locally, S3 in production) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="medtravel"
S3_SECRET_KEY="medtravel-secret"
S3_PRIVATE_BUCKET="medtravel-private"
S3_PUBLIC_BUCKET="medtravel-public"
S3_FORCE_PATH_STYLE=true

# --- email (Mailpit locally) ---
SMTP_HOST="localhost"
SMTP_PORT=1025
EMAIL_FROM="MedTravel <noreply@medtravel.local>"

# --- notifications: SMS and WhatsApp (dev delivers both to Mailpit as email; production must use real providers) ---
SMS_PROVIDER=dev
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
WHATSAPP_PROVIDER=dev
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=

# --- virus scanning ---
CLAMAV_HOST="localhost"
CLAMAV_PORT=3310

# --- exchange rates (refreshed every day at 06:00 India time) ---
# static (fixed development data), frankfurter (ECB, no key) or openexchangerates (needs the app id). Production refuses static.
FX_PROVIDER=static
# OPEN_EXCHANGE_RATES_APP_ID=
FX_REFRESH_CRON="0 6 * * *"

# --- public website refresh (after publish, unpublish and approved price changes) ---
# The website's /api/revalidate address and the shared secret (16+ characters; the website reads it as REVALIDATE_SECRET).
# Leave both empty to skip the refresh in development.
# WEB_REVALIDATE_URL="http://localhost:3000/api/revalidate"
# WEB_REVALIDATE_SECRET=
