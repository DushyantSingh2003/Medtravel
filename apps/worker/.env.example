NODE_ENV=development
LOG_LEVEL=debug

DATABASE_URL="postgresql://medtravel:medtravel@localhost:5432/medtravel?schema=public"
REDIS_URL="redis://localhost:6379"

# How many jobs one worker process handles at a time.
WORKER_CONCURRENCY=5

# --- object storage (MinIO locally, S3 in production) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="medtravel"
S3_SECRET_KEY="medtravel-secret"
S3_PRIVATE_BUCKET="medtravel-private"
S3_PUBLIC_BUCKET="medtravel-public"
S3_FORCE_PATH_STYLE=true

# --- email (Mailpit locally) ---
SMTP_HOST="localhost"
SMTP_PORT=1025
EMAIL_FROM="MedTravel <noreply@medtravel.local>"

# --- notifications: SMS and WhatsApp (dev delivers both to Mailpit as email; production must use real providers) ---
SMS_PROVIDER=dev
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
WHATSAPP_PROVIDER=dev
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=

# --- virus scanning ---
CLAMAV_HOST="localhost"
CLAMAV_PORT=3310
