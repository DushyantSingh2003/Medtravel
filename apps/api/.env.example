# --- runtime ---
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# --- database (see packages/db/.env.example) ---
DATABASE_URL="postgresql://medtravel:medtravel@localhost:5432/medtravel?schema=public"

# --- redis, shared with the worker ---
REDIS_URL="redis://localhost:6379"

# --- http ---
# Comma-separated list of origins allowed to send credentialed requests.
CORS_ORIGINS="http://localhost:3000,http://localhost:3002"

# --- object storage (MinIO locally, S3 in production) ---
S3_ENDPOINT="http://localhost:9000"
# Where browsers reach the bucket, when that differs from S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="medtravel"
S3_SECRET_KEY="medtravel-secret"
S3_PRIVATE_BUCKET="medtravel-private"
S3_PUBLIC_BUCKET="medtravel-public"
# Needed for MinIO; leave unset for AWS S3.
S3_FORCE_PATH_STYLE=true

# --- email (Mailpit locally: inbox at http://localhost:8025) ---
SMTP_HOST="localhost"
SMTP_PORT=1025
EMAIL_FROM="MedTravel <noreply@medtravel.local>"

# --- virus scanning ---
CLAMAV_HOST="localhost"
CLAMAV_PORT=3310

# --- authentication (F-03) ---
# Development-only defaults are built in, so these may stay unset locally. Production refuses the defaults.
# AUTH_TOKEN_SECRET: 32+ random characters (openssl rand -base64 48). AUTH_ENCRYPTION_KEY: 64 hex characters (openssl rand -hex 32).
# AUTH_TOKEN_SECRET=
# AUTH_ENCRYPTION_KEY=
# Where the portal lives (links in emails) and, for sibling subdomains, the cookie domain.
PORTAL_URL="http://localhost:3002"
# COOKIE_DOMAIN=.medtravel.example
# "capture" keeps mail in memory; "smtp" sends it through SMTP_HOST (Mailpit locally).
EMAIL_TRANSPORT=capture
# Skip the mandatory second factor for users who have not enrolled. Local development only (NODE_ENV=development).
AUTH_DEV_SKIP_2FA=true
# Number of reverse proxies (load balancers) in front of the API: 0 locally, 1 behind one load balancer.
TRUST_PROXY_HOPS=0
