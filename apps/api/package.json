{
  "name": "@medtravel/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --exec \"node --env-file=.env\"",
    "start": "node dist/main.js",
    "openapi:export": "DATABASE_URL=${DATABASE_URL:-postgresql://x:x@localhost:5432/x} REDIS_URL=${REDIS_URL:-redis://localhost:6379} node dist/scripts/export-openapi.js",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.2",
    "@fastify/static": "^10.1.5",
    "@medtravel/contracts": "workspace:*",
    "@medtravel/db": "workspace:*",
    "@medtravel/fx": "workspace:*",
    "@medtravel/notifications": "workspace:*",
    "@medtravel/realtime": "workspace:*",
    "@medtravel/storage": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@nestjs/platform-socket.io": "~12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/websockets": "~12.1.2",
    "@node-rs/argon2": "^2.2.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "fastify": "5.12.5",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^10.2.1",
    "otplib": "^13.5.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@medtravel/config": "workspace:*",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.1.2",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.39.5",
    "pdf-lib": "^1.17.1",
    "pino-pretty": "^13.1.2",
    "sharp": "^0.35.5",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.0.0",
    "tsx": "^4.21.1",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.11"
  }
}
