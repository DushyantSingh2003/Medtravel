# Base URL of the API, used by the generated client in the browser.
NEXT_PUBLIC_API_URL="http://localhost:3001"
PORT=3000

# Public website only. Both are baked into the build (NEXT_PUBLIC_*), and both are optional.
# Canonical base URL for links in search results, sitemap.xml and social previews.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# WhatsApp number, digits with country code (for example 919876543210). The floating chat button
# is hidden while this is empty. This is a dummy number for local development and the browser tests;
# deployed environments set a real one.
NEXT_PUBLIC_WHATSAPP_NUMBER="919999900000"

# Error reporting (Sentry). Leave empty to send nothing. The release build also sets SENTRY_AUTH_TOKEN, SENTRY_ORG,
# SENTRY_PROJECT_WEB and SENTRY_RELEASE to upload source maps and tag the release.
NEXT_PUBLIC_SENTRY_DSN=

# Shared secret the worker sends to /api/revalidate to refresh pages after a hospital, doctor or package changes (16+ characters).
# Leave empty to refuse every refresh request.
REVALIDATE_SECRET=
